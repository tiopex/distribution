conky.config = {
    out_to_wayland = true,
    alignment = 'top_left',
    background = false,
    font =  "DejaVu Sans Mono:normal:size=18",
    update_interval = 1.0,
    minimum_width = 1240,
    minimum_height = 1080,
    maximum_width = 1240,
    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = false,
    default_color = 'white',
    text_buffer_size = 4096,
    border_inner_margin = 0,
    gap_x = 0,
    gap_y = 0,
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    use_spacer = 'none',
    override_utf8_locale = true,
    color1 = '#00FFAA',
    color2 = '#FF8800',
    color3 = '#44AAFF',
    color4 = '#FF4444',
}

conky.text = [[
${font DejaVu Sans Mono:bold:size=18}${color1}SYSTEM ${hr 2}$color
${color}${nodename} - ${sysname} ${kernel}  ${alignr}Battery: ${execi 5 cat /sys/class/power_supply/battery/capacity}%
Uptime: ${uptime}  ${alignr}Usage: ${execi 5 awk '{printf "%.2f", $1/1000000}' /sys/class/power_supply/battery/current_now} A
Load: ${loadavg}  ${alignr}Voltage: ${execi 5 awk '{printf "%.2f", $1/1000000}' /sys/class/power_supply/battery/voltage_now} V
Processes: ${processes} (running: ${running_processes})  ${alignr}Power: ${execi 5 awk '{printf "%.2f", $1/1000000}' /sys/class/power_supply/battery/power_now} W
${alignr}Temp: ${execi 5 awk '{printf "%.1f", $1/10}' /sys/class/power_supply/battery/temp}°C

${font DejaVu Sans Mono:bold:size=18}${color2}CPU ${hr 2}$color
CPU: ${cpu cpu0}% ${alignr}${cpubar 8,200 cpu0}
CPU Frequency: ${execi 1 awk '{printf "%.0f", $1/1000}' /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq} MHz
CPU Temp: ${hwmon 0 temp 1}°C
${cpugraph 50,1240 ${color2} ${color4}}

${font DejaVu Sans Mono:bold:size=18}${color2}GPU ${hr 2}$color
GPU Frequency: ${execi 1 awk '{printf "%.0f", $1/1000000}' /sys/class/devfreq/*gpu*/cur_freq} MHz
GPU Temp: ${execi 2 awk '{printf "%.1f", $1/1000}' /sys/class/thermal/thermal_zone29/temp}°C

${font DejaVu Sans Mono:bold:size=18}${color3}MEMORY ${hr 2}$color
RAM: $mem / $memmax ${alignr}${membar 8,200}
Swap: $swap / $swapmax ${alignr}${swapbar 8,200}
${memgraph 50,1240 ${color3} ${color4}}

${font DejaVu Sans Mono:bold:size=18}${color4}DISK ${hr 2}$color
Storage: ${fs_used /storage} / ${fs_size /storage} ${alignr}${fs_bar 8,200 /storage}
I/O: ${diskio} ${alignr}${diskiograph 50,1240 ${color4} ${color2}}

${font DejaVu Sans Mono:bold:size=18}${color1}NETWORK ${hr 2}$color
Up: ${upspeed wlan0} ${alignr}${upspeedgraph wlan0 50,1000 ${color1} ${color2}}
Down: ${downspeed wlan0} ${alignr}${downspeedgraph wlan0 50,1000 ${color2} ${color4}}
Local IP: ${addr wlan0}


]]

